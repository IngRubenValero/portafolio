# Respaldos
*_backup.*
RESPALDO/

# Fuente de verdad única: las copias antiguas de datos NO se publican
data/projects copy*.json

# Respaldos automáticos que crea admin.html antes de cada escritura (solo locales)
data/projects.respaldo.json
data/site.respaldo.json
data/content.respaldo.json

# Sello local de la ultima publicacion (lo escribe publicar.sh, no se sube)
data/.estado-publicacion.json

# Originales JPG/PNG previos a la optimización WebP: se conservan en local,
# pero NO se publican (GitHub Pages solo sirve lo que está en el repo).
img/_originales/
# Imágenes que el admin aparta por no estar referenciadas (se mueven, no se borran).
img/_sin-usar/

# Versiones antiguas de estilos y scripts
*_v1.*

# Configuración local de publicación (nunca subir credenciales)
publicar.local.conf

# Datos de trabajo del asistente: no forman parte del sitio publicado
.workbuddy-ai/

# Bytecode de Python (generado al ejecutar/compilar las herramientas)
__pycache__/
*.pyc

# Archivos del sistema
.DS_Store
Thumbs.db
desktop.ini

# Editores
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*

# Dependencias (si se agregan en el futuro)
node_modules/
bower_components/

# Build (si se agrega proceso de build)
dist/
build/

# Temporal
*.tmp
*.temp
